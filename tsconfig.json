{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@lokal/shell": ["./src/lokal/shell.ts", "./src/shell/lokal-leer.ts"],
      "@lokal/ui": ["./src/lokal/ui.tsx", "./src/ui/lokal-leer.tsx"]
    }
  },
  "include": ["src", "test"]
}
