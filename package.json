{
  "name": "coop-deck",
  "version": "0.0.1",
  "description": "Coop Deck — a workspace for working side by side with coding CLIs: session on the left, the artefact you talk about on the right.",
  "private": true,
  "main": "dist/shell/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "symbol": "node scripts/symbol.mjs",
    "app": "node build.mjs && electron-builder --mac dir --arm64",
    "dmg": "node build.mjs && electron-builder --mac dmg --arm64",
    "app:linux": "node build.mjs && electron-builder --linux AppImage",
    "export": "node scripts/export.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmarkus42-rgb/coop-deck.git"
  },
  "homepage": "https://github.com/cmarkus42-rgb/coop-deck#readme",
  "bugs": {
    "url": "https://github.com/cmarkus42-rgb/coop-deck/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.2.1",
    "preact": "^11.2.0"
  },
  "author": "Christian Markus",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "tmux",
    "electron",
    "mcp"
  ],
  "build": {
    "appId": "dev.coopdeck.app",
    "productName": "Coop Deck",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "typen/**",
      "mobil/**",
      "package.json",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "!**/*.map"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": [
        "dir"
      ],
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Coop Deck records your dictation and recognises it locally on this machine. No audio leaves the computer. / Das Coop Deck nimmt dein Diktat auf und erkennt es lokal auf dieser Maschine. Kein Ton verlässt den Rechner."
      }
    }
  }
}
